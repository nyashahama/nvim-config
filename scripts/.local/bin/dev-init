#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'USAGE'
Usage:
  dev-init [--force] [path]

Copies the base development templates into a repository. Existing files are not
overwritten unless --force is passed.
USAGE
}

force=0
target="."

while [[ $# -gt 0 ]]; do
	case "$1" in
	--force)
		force=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		printf 'unknown option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	*)
		target="$1"
		shift
		;;
	esac
done

if [[ ! -d "$target" ]]; then
	printf 'not a directory: %s\n' "$target" >&2
	exit 2
fi

template_root="${DEV_TEMPLATES_DIR:-$HOME/.local/share/dev-templates}"
template_dir="$template_root/base"
if [[ ! -d "$template_dir" ]]; then
	printf 'missing template directory: %s\n' "$template_dir" >&2
	exit 1
fi

files=(.editorconfig .envrc .pre-commit-config.yaml mise.toml justfile)

for file in "${files[@]}"; do
	src="$template_dir/$file"
	dst="$target/$file"
	if [[ -e "$dst" && "$force" -ne 1 ]]; then
		printf '%s already exists; rerun with --force to replace it\n' "$dst" >&2
		exit 1
	fi
	cp -a "$src" "$dst"
	printf 'wrote %s\n' "$dst"
done

if [[ -f "$target/.envrc" ]] && command -v direnv >/dev/null 2>&1; then
	printf 'next: cd %s && direnv allow\n' "$target"
fi
